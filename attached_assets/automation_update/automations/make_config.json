{
  "baseUrl": "{{connection.baseUrl}}",
  "headers": {
    "Content-Type": "application/json",
    "Authorization": "Bearer {{connection.apiKey}}"
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] {{body.error || body.message}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization",
      "request.headers.apiKey"
    ]
  },
  "connection": {
    "useOauth2": false,
    "parameters": [
      {
        "name": "baseUrl",
        "type": "text",
        "label": "Base URL",
        "help": "https://YOUR-REPLIT-URL.repl.co/api"
      },
      {
        "name": "apiKey",
        "type": "text",
        "label": "API Key / Shared Secret",
        "help": "Use a shared secret stored in Replit"
      },
      {
        "name": "adminEmailList",
        "type": "array",
        "label": "Admin Emails",
        "help": "Emails allowed for admin actions",
        "items": {
          "type": "text"
        }
      },
      {
        "name": "supabaseUrl",
        "type": "text",
        "label": "Supabase URL",
        "help": "Optional"
      },
      {
        "name": "supabaseAnonKey",
        "type": "text",
        "label": "Supabase Anon Key",
        "help": "Optional"
      },
      {
        "name": "stripeSecretKey",
        "type": "text",
        "label": "Stripe Secret Key",
        "help": "Optional"
      },
      {
        "name": "productWebhook",
        "type": "text",
        "label": "Product Webhook URL",
        "help": "MAKE_WEBHOOK_PRODUCT"
      },
      {
        "name": "contentWebhook",
        "type": "text",
        "label": "Content Webhook URL",
        "help": "MAKE_WEBHOOK_CONTENT"
      },
      {
        "name": "backupWebhook",
        "type": "text",
        "label": "Backup Webhook URL",
        "help": "MAKE_WEBHOOK_BACKUP"
      }
    ]
  },
  "modules": [
    {
      "name": "Send Product Payload",
      "type": "http",
      "method": "POST",
      "endpoint": "{{connection.baseUrl}}/automations/product",
      "headers": {
        "Authorization": "Bearer {{connection.apiKey}}",
        "Content-Type": "application/json"
      },
      "body": "{{parameters.productBody}}",
      "parameters": [
        {
          "name": "productBody",
          "type": "object",
          "label": "Product Payload"
        }
      ]
    },
    {
      "name": "Send Content Payload",
      "type": "http",
      "method": "POST",
      "endpoint": "{{connection.baseUrl}}/automations/content",
      "headers": {
        "Authorization": "Bearer {{connection.apiKey}}",
        "Content-Type": "application/json"
      },
      "body": "{{parameters.contentBody}}",
      "parameters": [
        {
          "name": "contentBody",
          "type": "object",
          "label": "Content Payload"
        }
      ]
    },
    {
      "name": "Send Backup Notice",
      "type": "http",
      "method": "POST",
      "endpoint": "{{connection.baseUrl}}/automations/backup",
      "headers": {
        "Authorization": "Bearer {{connection.apiKey}}",
        "Content-Type": "application/json"
      },
      "body": "{\"at\":\"{{now}}\"}",
      "parameters": []
    }
  ]
}