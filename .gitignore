MidnightMagnolia_StarterDataPack.zip
MidnightMagnolia_MasterPrompt_Fixed.zip
MidnightMagnolia_BusinessPlan.docx
MidnightMagnolia_env_template.md

# === VS Code / Local Build ===
.vscode/
.history/
*.code-workspace
*.workspace
*.iml

# === Media / Uploads (keep cloud-hosted only) ===
public/uploads/
public/tmp/
*.mp4
*.mov
*.psd
*.ai
*.xcf
*.tiff
*.tif

# === Python / Helper Scripts (Replit/AI use) ===
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/
ENV/
