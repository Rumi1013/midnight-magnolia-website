# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ────────────────────────────────────────────────
# 🌙 Midnight Magnolia .gitignore
# Rooted in Mystery. Blooming in Truth.
# Protects secrets, build files, and local environment
# ────────────────────────────────────────────────

# === Node.js / Next.js ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.pnpm-store/
dist/
build/
.next/
out/
.cache/
*.tsbuildinfo

# === Monorepo structure ===
apps/*/node_modules/
packages/*/node_modules/
apps/*/.next/
packages/*/.next/
apps/*/dist/
packages/*/dist/
apps/*/out/
packages/*/out/

# === Environment & Config ===
.env
.env.local
.env.development
.env.production
.env.test
.env*.local
.envrc
# Safe templates only:
!.env.example
!MidnightMagnolia_env_template.md

# === OS / System ===
.DS_Store
Thumbs.db
Icon?
ehthumbs.db
desktop.ini

# === Logs & Diagnostics ===
*.log
logs/
debug/
*.pid
*.seed
*.pid.lock

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak
*.tmp
*.orig
*.rej

# === Replit ===
.replit
replit.nix
__pycache__/
*.pyc

# === DigitalOcean / Deployment ===
.do/
.docker/
.dockerignore
docker-compose.yml
Dockerfile
.DS_Store

# === Git / LFS / Cache ===
.git/
.gitignore~
.gitmodules
.gitconfig
*.orig
*.lock

